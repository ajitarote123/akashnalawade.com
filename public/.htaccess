DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^about$ /about/ [R=301,L]
  RewriteRule ^work$ /work/ [R=301,L]
  RewriteRule ^terms$ /terms/ [R=301,L]
  RewriteRule ^credits$ /credits/ [R=301,L]
  RewriteRule ^sitemap$ /sitemap/ [R=301,L]
</IfModule>
